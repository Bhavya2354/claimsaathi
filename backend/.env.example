# Copy to backend/.env and fill in. Never commit the real file.

# --- Runtime ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Cases (uploads are processed in memory; cases are purged after this) ---
CASE_TTL_HOURS=24

# --- Database (SQLite locally, Postgres in production) ---
DATABASE_URL=sqlite+aiosqlite:///../data/claimsaathi.db
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# --- Model providers (all free tiers). Leave a key empty to switch that provider off. ---
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_API_KEY=

# --- Routes: ordered fallback chains of provider:model. Entries for disabled providers are skipped. ---
ROUTE_REASONING=groq:openai/gpt-oss-120b,gemini:gemini-2.5-flash,cerebras:gpt-oss-120b,groq:llama-3.3-70b-versatile,openrouter:deepseek/deepseek-chat-v3.1:free,mistral:mistral-small-latest,github_models:openai/gpt-4.1-mini,ollama:qwen3.5:9b
ROUTE_FAST=groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash-lite,cerebras:llama3.1-8b,groq:llama-3.1-8b-instant,mistral:mistral-small-latest,openrouter:meta-llama/llama-3.3-70b-instruct:free,ollama:granite4.2:8b
ROUTE_VISION=gemini:gemini-2.5-flash,groq:meta-llama/llama-4-scout-17b-16e-instruct,github_models:openai/gpt-4.1-mini,mistral:mistral-small-latest,ollama:gemma4:e2b-it-qat

# --- Retrieval (embedded Qdrant locally; set QDRANT_URL instead for a server) ---
QDRANT_PATH=../data/qdrant
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=
QDRANT_COLLECTION=policy_clauses
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=../data/models

# --- Privacy ---
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_VAULT_KEY=
PII_SPACY_MODEL=en_core_web_sm

# --- API ---
API_CORS_ORIGINS=["http://localhost:3000"]
API_RATE_LIMIT_PER_MINUTE=60

# --- Tracing (optional, Langfuse free tier) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
